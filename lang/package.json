{
	"name": "@oofdere/crabrave-lang",
	"version": "0.0.0",
	"private": true,
	"description": "crabrave as a language: TypeScript with Rust-style enums, match and ?, checked by TypeScript 7.1 through a content mapper",
	"type": "module",
	"license": "MIT",
	"bin": {
		"crabrave": "./src/cli.ts"
	},
	"exports": {
		".": "./src/compile.ts",
		"./prelude": "./src/prelude.crab",
		"./vite": "./src/vite.ts",
		"./bun": "./src/bun.ts",
		"./register": "./src/register.ts"
	},
	"typescript": {
		"contentMapper": {
			"exec": [
				"node",
				"src/mapper.ts"
			]
		}
	},
	"scripts": {
		"build:grammar": "cd grammar && tree-sitter generate && tree-sitter build --wasm -o tree-sitter-crabrave.wasm",
		"test:grammar": "cd grammar && tree-sitter generate && tree-sitter test",
		"typecheck": "tsc -p . --runExternalCode && tsc -p examples --runExternalCode",
		"test": "vitest run"
	},
	"dependencies": {
		"ts-content-mapper": "0.1.0",
		"web-tree-sitter": "0.27.1"
	},
	"devDependencies": {
		"@oofdere/crabrave-lang": "file:.",
		"@types/bun": "1.4.3",
		"@types/node": "22.20.5",
		"tree-sitter-cli": "0.27.1",
		"tree-sitter-typescript": "0.23.2",
		"typescript": "7.1.0-dev.20261014.1",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	},
	"trustedDependencies": [
		"tree-sitter-cli"
	]
}
